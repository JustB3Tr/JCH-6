generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PlaceType {
  park
  beach
  trail
  garden
  viewpoint
  plaza
  market
  cafe
  library
  museum
  sports
  other
}

enum RsvpStatus {
  going
  maybe
  cant
}

enum MemberRole {
  member
  organizer
}

enum ThreadKind {
  direct
  group
  community
}

enum MessageRole {
  user
  assistant
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String
  bio           String    @default("")
  homeArea      String?
  // Private accounts are hidden from people search, member and attendee
  // lists, and public profiles. See lib/privacy.ts.
  isPrivate     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  places        Place[]        @relation("PlaceCreator")
  savedPlaces   SavedPlace[]
  events        Event[]        @relation("EventHost")
  rsvps         Rsvp[]
  feedbacks     Feedback[]
  memberships   Membership[]
  aiChats       AiChat[]
  chatMessages  ChatMessage[]
  threads       ChatThread[]   @relation("ThreadCreator")
  threadMembers ThreadMember[]

  @@index([isPrivate, name])
}

model Place {
  id            String    @id @default(cuid())
  googlePlaceId String?   @unique
  name          String
  description   String    @default("")
  type          PlaceType @default(other)
  lat           Float
  lng           Float
  address       String?
  // Google Places photo resource name; resolved by /api/places/[id]/photo.
  photoRef      String?
  // Denormalized from Feedback so map and list queries never aggregate.
  ratingAvg     Float?
  ratingCount   Int       @default(0)
  approved      Boolean   @default(true)
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  createdBy User?          @relation("PlaceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  amenities PlaceAmenity[]
  events    Event[]
  feedbacks Feedback[]
  savedBy   SavedPlace[]

  @@index([approved, type])
  @@index([lat, lng])
  @@index([createdById])
}

model Amenity {
  id    String @id @default(cuid())
  slug  String @unique
  label String
  icon  String @default("check")

  places PlaceAmenity[]
}

model PlaceAmenity {
  placeId   String
  amenityId String

  place   Place   @relation(fields: [placeId], references: [id], onDelete: Cascade)
  amenity Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([placeId, amenityId])
  @@index([amenityId])
}

model SavedPlace {
  userId    String
  placeId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@id([userId, placeId])
  @@index([placeId])
}

model Community {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String   @default("")
  icon        String   @default("users")
  tint        String   @default("blue")
  createdAt   DateTime @default(now())

  memberships Membership[]
  events      Event[]
  threads     ChatThread[]
}

model Membership {
  userId      String
  communityId String
  role        MemberRole @default(member)
  joinedAt    DateTime   @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@id([userId, communityId])
  @@index([communityId])
}

model Event {
  id          String    @id @default(cuid())
  title       String
  description String    @default("")
  startsAt    DateTime
  endsAt      DateTime?
  placeId     String?
  communityId String?
  hostId      String
  createdAt   DateTime  @default(now())

  place     Place?     @relation(fields: [placeId], references: [id], onDelete: SetNull)
  community Community? @relation(fields: [communityId], references: [id], onDelete: Cascade)
  host      User       @relation("EventHost", fields: [hostId], references: [id], onDelete: Cascade)
  rsvps     Rsvp[]
  feedbacks Feedback[]

  @@index([startsAt])
  @@index([placeId, startsAt])
  @@index([communityId, startsAt])
  @@index([hostId])
}

model Rsvp {
  id        String     @id @default(cuid())
  eventId   String
  userId    String
  status    RsvpStatus @default(going)
  createdAt DateTime   @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId, status])
}

model Feedback {
  id        String   @id @default(cuid())
  placeId   String?
  eventId   String?
  userId    String
  rating    Int
  comment   String   @default("")
  createdAt DateTime @default(now())

  place Place? @relation(fields: [placeId], references: [id], onDelete: Cascade)
  event Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One review per person per place; posting again edits it.
  @@unique([placeId, userId])
  @@index([placeId, createdAt])
  @@index([eventId])
  @@index([userId])
}

model AiChat {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("New chat")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AiMessage[]

  @@index([userId, updatedAt])
}

model AiMessage {
  id        String      @id @default(cuid())
  chatId    String
  role      MessageRole
  content   String
  // Tools used and place ids cited, so the UI can re-render result cards.
  meta      Json?
  createdAt DateTime    @default(now())

  chat AiChat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
}

model ChatThread {
  id            String     @id @default(cuid())
  kind          ThreadKind @default(community)
  communityId   String?
  name          String?
  // Sorted pair of user ids for direct threads, so opening a DM is idempotent.
  directKey     String?    @unique
  createdById   String?
  createdAt     DateTime   @default(now())
  lastMessageAt DateTime   @default(now())

  createdBy User?          @relation("ThreadCreator", fields: [createdById], references: [id], onDelete: SetNull)
  community Community?     @relation(fields: [communityId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]
  members   ThreadMember[]

  @@index([communityId])
  @@index([lastMessageAt])
}

// Every participant of every thread kind has a row here. It is the single
// source of truth for who may read or post in a thread.
model ThreadMember {
  threadId   String
  userId     String
  joinedAt   DateTime @default(now())
  lastReadAt DateTime @default(now())

  thread ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([threadId, userId])
  @@index([userId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  threadId  String
  userId    String
  body      String
  createdAt DateTime @default(now())

  thread ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@index([userId])
}

// Curated facts the AI guide retrieves with the search_knowledge tool.
model KnowledgeArticle {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  category  String
  body      String
  keywords  String   @default("")
  updatedAt DateTime @default(now()) @updatedAt

  @@index([category])
}
